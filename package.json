{
  "name": "marfim-studio-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "dev:demo": "node scripts/with-env.mjs MARFIM_DATA_DIR=.data/demo -- next dev",
    "start:demo": "node scripts/with-env.mjs MARFIM_DATA_DIR=.data/demo -- next start",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}

# Database
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# Or local PGlite
# MARFIM_DATA_DIR=.data/pglite

# Email (optional for invites)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-app

# GitHub OAuth (optional for 2FA login)
GITHUB_CLIENT_ID=seu-client-id
GITHUB_CLIENT_SECRET=seu-client-secret

# Firebase Cloud Messaging (optional for push notifications)
FCM_API_KEY=sua-chave-fcm

# Google Calendar integration (optional)
GOOGLE_CLIENT_ID=seu-client-id
GOOGLE_CLIENT_SECRET=seu-client-secret

# NF-e integration (optional)
NFE_CERTIFICATE=caminho-para-certificado.pfx
NFE_PASSWORD=senha-certificado

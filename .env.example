# --- Desenvolvimento local (sem variáveis): usa banco de arquivo em .data/pglite ---
# MARFIM_DATA_DIR=.data/pglite

# --- Produção (obrigatório): PostgreSQL gerenciado, ex.: string de conexão do Supabase (Settings > Database) ---
# DATABASE_URL=postgresql://postgres:SENHA@db.xxxx.supabase.co:5432/postgres

# --- Rotinas diárias via agendador externo (Vercel Cron): segredo longo e aleatório ---
# CRON_SECRET=
